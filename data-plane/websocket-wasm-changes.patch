+#[cfg(all(feature = "wasm", not(feature = "native")))]
+pub fn spawn<F>(future: F) -> JoinHandle<F::Output>
+where
+    F: std::future::Future + 'static,
+{
+    wasm_bindgen_futures::spawn_local(async move {
+        future.await;
+    });
+    JoinHandle {
+        _marker: std::marker::PhantomData,
+    }
